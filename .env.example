# Copy to .env and fill values
RPC_URL=https://rpc.doma.xyz/
# Optional extra Doma RPC fallbacks, comma-separated.
# Example: DOMA_RPC_URLS=https://your-rpc-1.example,https://your-rpc-2.example
DOMA_RPC_URLS=
SUBGRAPH_URL=https://graph.doma.xyz/subgraphs/name/uniswap-v3-doma-mainnet
CHAIN_ID=97477

KEYS_FILE=keys.txt
WALLETS_FILE=wallets.txt
API_KEYS_FILE=api_keys.txt
PROXY_FILE=proxies.txt
LOG_FILE=logs/bot.log
TRADES_CSV_FILE=reports/trades.csv
POINTS_CSV_FILE=reports/points.csv
REPLAY_CSV_FILE=reports/trades.csv
PRIVY_ACCESS_TOKENS_FILE=privy_access_tokens.txt
PRIVY_REFRESH_TOKENS_FILE=privy_refresh_tokens.txt
TWOCAPTCHA_API_KEY=
CAPTCHASONIC_API_KEY=
CAPTCHA_PROVIDER=2captcha
OKX_API_KEYS_FILE=okx_api_keys.txt
OKX_WITHDRAW_ADDRESSES_FILE=wallets.txt
OKX_BASE_URL=https://www.okx.com
CONTRACTS_FILE=contracts.json
ALLOWLIST_POOLS_FILE=allowlist_pools.txt

# Optional (can stay empty; first wallet from wallets.txt will be used)
ACCOUNT_ADDRESS=
PRIVATE_KEY=

# Execution defaults
PAPER_MODE=false
DRY_RUN=false
ENABLE_EXECUTION=true
REQUIRE_LIVE_CONFIRMATION=false

# Delays between wallets (points + close-all positions)
WALLET_DELAY_MIN_SEC=10
WALLET_DELAY_MAX_SEC=20

